{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModuDesk",
  "version": "0.4.0",
  "identifier": "edu.mpw.modudesk",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModuDesk — 模块化个人工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
