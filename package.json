{
  "name": "mpw-monorepo",
  "private": true,
  "version": "0.7.1",
  "description": "Modular Personal Workspace — workspace shell + plugin platform",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node release/server.mjs",
    "desktop:dev": "node tools/desktop.mjs dev",
    "desktop:build": "node tools/desktop.mjs build",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "npm run dev -w @mpw/app",
    "build": "npm run build -w @mpw/app",
    "preview": "npm run preview -w @mpw/app",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
