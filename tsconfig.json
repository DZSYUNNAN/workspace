{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@mpw/shared": [
        "packages/shared/src/index.ts"
      ],
      "@mpw/kernel": [
        "packages/kernel/src/index.ts"
      ],
      "@mpw/plugin-notes": [
        "plugins/notes/src/index.ts"
      ],
      "@mpw/plugin-references": [
        "plugins/references/src/index.ts"
      ],
      "@mpw/plugin-writing": [
        "plugins/writing/src/index.ts"
      ],
      "@mpw/plugin-email": [
        "plugins/email/src/index.ts"
      ],
      "@mpw/plugin-files": [
        "plugins/files/src/index.ts"
      ],
      "@mpw/plugin-ai": [
        "plugins/ai/src/index.ts"
      ],
      "@mpw/ui": [
        "packages/ui/src/index.tsx"
      ],
      "@mpw/plugin-tasks": [
        "plugins/tasks/src/index.ts"
      ],
      "@mpw/plugin-projects": [
        "plugins/projects/src/index.ts"
      ],
      "@mpw/plugin-layout-controls": [
        "plugins/layout-controls/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "vitest.config.ts",
    "apps/web/vite.config.ts"
  ]
}
